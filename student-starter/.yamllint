extends: default
ignore: |
  .venv/
  lab-output/
  student-starter/
rules:
  line-length:
    max: 140
    level: warning
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  document-start: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
